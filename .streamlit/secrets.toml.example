# Copia este archivo como .streamlit/secrets.toml (está en .gitignore) para probar local.
# En Streamlit Cloud pega lo mismo en Settings > Secrets. NO lo subas al repo con valores.
APP_USUARIO = ""
APP_CLAVE = ""
# Misma URL que el dashboard de proyectos, cambiando SOLO el usuario y la clave:
#   proy_dashboard_ro.<ref>  ->  vg_dashboard_ro.<ref>
SUPABASE_DB_URL_RO = ""
# "value_generation" (datos reales) o "vg_demo" (datos de prueba)
ESQUEMA = "vg_demo"
